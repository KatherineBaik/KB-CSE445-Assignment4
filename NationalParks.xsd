<?xml version="1.0" encoding="utf-8"?>
<schema id="XMLSchema1"
    targetNamespace="https://katherinebaik.github.io/KB-CSE445-Assignment4/NationalParks.xsd"
    elementFormDefault="qualified" attributeFormDefault="unqualified"
    xmlns="http://www.w3.org/2001/XMLSchema"
>
  <element name="NationalParks">
    <complexType>
      <sequence>
        <element name="NationalPark">
          <complexType>
            <sequence>
              <element name="Name" type="string" minOccurs="1" maxOccurs="1"/>
              <element name="Phone" type="string" minOccurs="1" maxOccurs="unbounded"/>
              <element name="Address">
                <complexType>
                  <sequence>
                    <element name="Number" type="int" minOccurs="1" maxOccurs="1"/>
                    <element name="Street" type="string" minOccurs="1" maxOccurs="1"/>
                    <element name="City" type="string" minOccurs="1" maxOccurs="1"/>
                    <element name="State" type="string" minOccurs="1" maxOccurs="1"/>
                    <element name="Zip" type="int" minOccurs="1" maxOccurs="1"/>
                  </sequence>
                  <attribute name="nearest_airport" type="string" use="required" />
                </complexType>
              </element>
            </sequence>
            <attribute name="rating" type="xs:decimal" use="optional" />
          </complexType>
        </element>
      </sequence>
    </complexType>
  </element>
</schema>